{
	"name": "bloggulus",
	"version": "0.7.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"deploy": "ssh -t derz@bloggulus.com 'cd /usr/local/src/bloggulus-svelte && sudo mfd deploy'",
		"preview": "vite preview",
		"migrate": "tsx ./src/lib/server/tools/migrate.ts",
		"test": "NODE_ENV=test npm run migrate && vitest run",
		"check": "tsc && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"update": "npm-check-updates -u"
	},
	"dependencies": {
		"@iarna/toml": "^2.2.5",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/auto-instrumentations-node": "^0.80.0",
		"@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
		"@opentelemetry/sdk-logs": "^0.222.0",
		"@opentelemetry/sdk-node": "^0.222.0",
		"arctic": "^3.7.0",
		"croner": "^10.0.1",
		"p-limit": "^7.3.3",
		"pg": "^8.23.1",
		"prom-client": "^15.1.3",
		"rss-parser": "^3.13.0",
		"sql-template-strings": "^2.2.2",
		"tsx": "^4.23.15",
		"undici": "^8.11.2"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/chance": "^1.1.8",
		"@types/lodash": "^4.17.25",
		"@types/minimist": "^1.2.5",
		"@types/pg": "^8.23.1",
		"@types/xml2js": "^0.4.14",
		"chance": "^1.1.13",
		"npm-check-updates": "^23.1.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.0",
		"vite": "^8.3.2",
		"vitest": "^5.0.3",
		"xml2js": "^0.6.2"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"prettier": {
		"arrowParens": "always",
		"bracketSameLine": false,
		"bracketSpacing": true,
		"jsxSingleQuote": false,
		"printWidth": 120,
		"semi": true,
		"singleQuote": false,
		"trailingComma": "all",
		"useTabs": true,
		"importOrder": [
			"<BUILTIN_MODULES>",
			"",
			"<THIRD_PARTY_MODULES>",
			"",
			"^\\#lib/(.*)$",
			"",
			"^[.]"
		],
		"importOrderCaseSensitive": false,
		"importOrderTypeScriptVersion": "5.0.0",
		"importOrderParserPlugins": [
			"typescript"
		],
		"plugins": [
			"@ianvs/prettier-plugin-sort-imports",
			"prettier-plugin-svelte"
		],
		"overrides": [
			{
				"files": "*.svelte",
				"options": {
					"parser": "svelte"
				}
			}
		]
	}
}
