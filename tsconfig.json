{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"noImplicitAny": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noImplicitThis": true,
		"noPropertyAccessFromIndexSignature": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"strict": true,
		"strictNullChecks": true
	},
	"include": ["src", "vite.config.ts"]
}
